<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" 
        d:DesignWidth="800" 
        d:DesignHeight="450"
        x:Class="osuArchiveToolkit.MainWindow"
        Title="osuArchiveToolkit">
    
        <StackPanel Margin="20" Spacing="10">
            <TextBlock
                Text="osu! Mascot Archive Toolkit"
                HorizontalAlignment="Center"
                FontSize="22"
                FontWeight="SemiBold">
            </TextBlock>
            
            <!-- LOG CONSOLE -->
            <TextBox
                x:Name="StatusLog"
                IsReadOnly="True"
                AcceptsReturn="True"
                FontSize="15"
                Height="250">
            </TextBox>
               
            <!-- SETUP PANEL -->
            <StackPanel
                x:Name="SetupPanel"
                Spacing="10">
                
                <TextBlock
                    x:Name="WorkspaceStatusText"
                    Text="Workspace: not selected">
                </TextBlock>
                
                <TextBlock
                    x:Name="GitUserStatusText"
                    Text="Git User: Not loaded">
                </TextBlock>
                
                   <Button
                       x:Name="GitUserButton"
                       Content="Retry Git User load"
                       Click="OnLoadGitUserClick">
                   </Button>
                
                <Button
                    x:Name="SelectWorkspaceButton"
                    Content="Select workspace path"
                    Click="OnSelectWorkspaceClick">
                </Button>
               </StackPanel> 
            
            <!-- INTAKE PANEL -->
            <StackPanel
                x:Name="IntakePanel"
                Spacing="10"
                IsVisible="False">
    
                <TextBlock 
                    Text="Intake Mode">
                </TextBlock>
            
                <Button
                    x:Name="BackButton"
                    Content="Back"
                    Click="OnBackClick"
                    HorizontalAlignment="Left">
                </Button>
                <Button
                    x:Name="SelectImageButton"
                    Content="Import Image"
                    Click="OnSelectImageClick">
                </Button>
            </StackPanel>
            
            <Grid>
                <Button
                    x:Name="NextButton"
                    Content="Next"
                    IsEnabled="False"
                    HorizontalAlignment="Right"
                    Click="OnNextClick">
                </Button>
            </Grid>
        </StackPanel>
        
       

</Window>